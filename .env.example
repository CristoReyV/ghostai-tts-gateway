# ─────────────────────────────────────────────────────────────
# GhostAI TTS Gateway — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── ElevenLabs ────────────────────────────────────────────────
# Required. Your ElevenLabs secret API key.
# Obtainable at https://elevenlabs.io/app/settings/api-keys
# This key is used ONLY in backend → ElevenLabs calls.
# It MUST NOT be sent to or accessible from the browser.
ELEVENLABS_API_KEY=

# Default model when the client does not specify one.
# Recommended: eleven_multilingual_v2
ELEVENLABS_DEFAULT_MODEL_ID=eleven_multilingual_v2

# Default audio output format.
# Supported values: mp3_44100_128 | mp3_44100_192 | mp3_22050_32
#                   pcm_16000 | pcm_22050 | pcm_24000 | pcm_44100 | ulaw_8000
ELEVENLABS_DEFAULT_OUTPUT_FORMAT=mp3_44100_128

# Timeout for ElevenLabs HTTP requests in milliseconds. Default: 30000
ELEVENLABS_TIMEOUT_MS=30000

# In-memory cache TTL for /voices and /models in milliseconds. Default: 120000
ELEVENLABS_CACHE_TTL_MS=120000

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Leave empty to allow all origins (not recommended for production).
# Example: https://studio.ghostai.io,https://app.ghostai.io
GHOSTAI_ALLOWED_ORIGINS=

# ── Validation ────────────────────────────────────────────────
# Maximum number of characters allowed per TTS request. Default: 5000
TTS_MAX_TEXT_LENGTH=5000
